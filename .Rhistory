dir_delete(dir)
}
}
wav_files_result <- dir_ls(destination_folder, recurse = TRUE, glob = "*.wav")
wav_count_result <- length(wav_files_result)
# Print the result
cat("Number of .wav files:", wav_count_result, "\n")
