library(shiny)
library(leaflet)
set.seed(123)
make_points <- function(n) {
data.frame(
lat = runif(n, 37, 38),
lng = runif(n, -123, -122),
intensity = runif(n, 1, 100)  # represents sampling intensity
)
}
points1 <- make_points(10)
points2 <- make_points(10)
points3 <- make_points(10)
points4 <- make_points(10)
ui <- fluidPage(
titlePanel("Scrollable Maps with Sampling Intensity"),
fluidRow(
lapply(1:4, function(i) {
column(
6,
selectInput(
paste0("dataset", i),
paste("Map", i, "Dataset"),
choices = c("Set 1", "Set 2", "Set 3", "Set 4")
),
leafletOutput(paste0("map", i), height = 400)
)
})
)
)
server <- function(input, output, session) {
data_list <- list(points1, points2, points3, points4)
lapply(1:4, function(i) {
map_id <- paste0("map", i)
select_id <- paste0("dataset", i)
# Initialize map
output[[map_id]] <- renderLeaflet({
leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%  # clean base layer
setView(lng = -122.5, lat = 37.5, zoom = 9)
})
observeEvent(input[[select_id]], {
idx <- match(input[[select_id]], c("Set 1", "Set 2", "Set 3", "Set 4"))
df <- data_list[[idx]]
radius <- scales::rescale(df$intensity, to = c(3, 15))
leafletProxy(map_id) %>%
clearMarkers() %>%
clearControls() %>%
addCircleMarkers(
data = df,
lng = ~lng, lat = ~lat,
radius = radius,
color = "red",
fillOpacity = 0.6,
label = ~paste0("Intensity: ", round(intensity, 1))
)
})
})
shinyApp(ui, server)
shinyApp(ui, server)
