server <- function(input, output, session) {
# Store datasets in a list for easy reference
data_list <- list(points1, points2, points3, points4)
# Loop through each map / dropdown pair
lapply(1:4, function(i) {
map_id <- paste0("map", i)
select_id <- paste0("dataset", i)
# Initialize each map when the app starts
output[[map_id]] <- renderLeaflet({
leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%  # clean basemap
setView(lng = -122.5, lat = 37.5, zoom = 9)
})
# Observe dataset selection changes
observeEvent(input[[select_id]], {
# Find which dataset corresponds to the selected label
idx <- match(input[[select_id]], c("Set 1", "Set 2", "Set 3", "Set 4"))
df <- data_list[[idx]]
# Rescale intensity to reasonable marker sizes
radius <- scales::rescale(df$intensity, to = c(3, 15))
# Update the corresponding map with new points
leafletProxy(map_id) %>%
clearMarkers() %>%
clearControls() %>%
addCircleMarkers(
data = df,
lng = ~lng, lat = ~lat,
radius = radius,
color = "red",
fillOpacity = 0.6,
label = ~paste0("Intensity: ", round(intensity, 1))
)
})
})
}
